{
  "name": "energy-dashboard",
  "main": "gate/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // 运营数据页通过 Service binding 调用私有的 vcom-api Worker（需先部署 vcom 仓库的 api/）
  "services": [
    { "binding": "VCOM_API", "service": "vcom-api" }
  ]
}
